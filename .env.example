# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Full CDSS demo URL including the access token. Use lang=1 for English.
# ref_id is replaced automatically for every test.
CDSS_URL=https://<cdss-demo-host>/?ref_id=1&lang=1&token=<your-token>&srcTyp=HWC&dob=30-08-1999&gendercode=2

# Optional
# WORKERS=4               parallel browsers
# RUN_KNOWN_BUGS=1        also run tests listed in data/known-bugs.json
# ATTEMPT_LIMIT_SEC=150   max seconds per consultation attempt
# RUN_DATE=2026-11-20     results folder date (default: today)
